# ==============================================================================
# Environment Configuration for Universal Multi-Modal Agentic RAG
# ==============================================================================

# Groq API Key (Used for Qwen 3.8 27B Vision VLM and evaluation models)
GROQ_API=gsk_your_groq_api_key

# Qdrant Vector Database (Cloud or Self-Hosted)
# For Qdrant Cloud:
QDRANT_URL=https://your-cluster-id.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
# For local Qdrant container:
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Hugging Face ZeroGPU ColPali Microservice
# Pre-configured public Space or your cloned Space:
COLPALI_SPACE=https://rayyan0-colpali.hf.space
# Your Hugging Face read token (https://huggingface.co/settings/tokens)
HF_TOKEN=hf_your_huggingface_token

# Optional: Custom Ollama Host (default: http://localhost:11434, in Docker Compose: http://ollama:11434)
# OLLAMA_HOST=http://localhost:11434
