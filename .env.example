# ==============================================================================
# Environment Configuration for Universal Multi-Modal Agentic RAG
# ==============================================================================

# Groq API Key (Used for Qwen 3.8 27B Vision VLM and evaluation models)
GROQ_API=gsk_your_groq_api_key

# Qdrant Vector Database (Cloud or Self-Hosted)
# For Qdrant Cloud:
QDRANT_URL=https://your-cluster-id.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
# For local Qdrant container:
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Hugging Face ZeroGPU ColPali Microservice
# Pre-configured public Space or your cloned Space:
COLPALI_SPACE=https://rayyan0-colpali.hf.space
# Your Hugging Face read token (https://huggingface.co/settings/tokens)
HF_TOKEN=hf_your_huggingface_token

# Google Gemini API Key (Used for high-performance 768-dim cloud embeddings via text-embedding)
# Free key from https://aistudio.google.com/app/apikey (0 local RAM, runs 24/7 in cloud)
GEMINI_API_KEY=your_gemini_api_key

# Optional: Fallback to local Ollama Host (default: http://localhost:11434, in Docker Compose: http://ollama:11434)
# OLLAMA_HOST=http://localhost:11434

# ==============================================================================
# Resource Detection (optional overrides — auto-detected by default)
# ==============================================================================
# The backend reads the cgroup limit (Docker/Render) or host RAM and selects:
#   low-memory  : PyMuPDF Lite, 10 MB / 25 pages, table detection off
#   full mode   : IBM Docling, 50 MB / 150 pages, table extraction on
# Auto mode uses Docling only when the usable budget is >= 3500 MB and at least
# 1800 MB is currently available. Leave everything below commented out unless
# you need to force a mode.
# USE_DOCLING=1                 # 1=force Docling, 0=force PyMuPDF Lite
# LOW_MEMORY_PARSER=1           # 1=force low-memory mode, 0=force full mode
# DOCLING_MIN_RAM_MB=3500       # Minimum usable RAM for auto Docling
# DOCLING_MIN_AVAILABLE_MB=1800 # Minimum free headroom for auto Docling
# MAX_UPLOAD_MB=50              # Defaults: 10 (low-memory) / 50 (full mode)
# MAX_UPLOAD_PAGES=150          # Defaults: 25 (low-memory) / 150 (full mode)
# ENABLE_TABLE_DETECTION=1      # Auto: off in low-memory, on in full mode
# MIN_FIGURE_AREA_PX=8000       # Drop signature/logo crops below this pixel area
