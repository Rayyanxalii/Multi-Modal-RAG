.git
.gitignore
.venv
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.ruff_cache
.vscode
.idea

# Do not bake secrets, local databases or debug logs into the image
.env
data/chat_history.db*
data/retrieval_runs/*
data/experiments/*

# Never bake user uploads or generated ingestion assets into the image
data/users
data/raw/*.pdf
data/rendered_pages/*
data/chunks/*
data/figures/*
data/tables/*
data/embeddings/*
